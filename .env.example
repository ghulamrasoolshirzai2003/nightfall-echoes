# Copy this file to ".env" and fill in your keys (for local testing).
# In GitHub Actions these come from repository Secrets instead.

# Google Gemini (free) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API key (free) — Google Cloud Console
YOUTUBE_API_KEY=

# YouTube OAuth (for uploading) — from your Google Cloud OAuth client
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Telegram bot (System B: Suno + Telegram workflow) — see SETUP.md Part E
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pexels (free stock video footage for System B's video background) — see SETUP.md Part F
PEXELS_API_KEY=
